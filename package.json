{
  "name": "bob-powertoys",
  "displayName": "PowerToys for Bob",
  "description": "Enhanced development tools for IBM Bob: debugging, terminal access, multi-root workspace support, and quality-of-life improvements.",
  "version": "0.8.3",
  "icon": "assets/icon.png",
  "license": "MIT",
  "publisher": "peerpalo",
  "repository": {
    "type": "git",
    "url": "https://github.com/peerpalo/bob-powertoys"
  },
  "author": {
    "name": "Pierpaolo Battaglione",
    "email": "pierpaolo.battaglione@ibm.com"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Chat",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onDebug",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bob-powertoys.showStatus",
        "category": "PowerToys for Bob",
        "title": "Show Status"
      },
      {
        "command": "bob-powertoys.newTaskInWindow",
        "category": "PowerToys for Bob",
        "title": "New Task In Window",
        "shortTitle": "New Task In Window"
      },
      {
        "command": "bob-powertoys.openTaskInWindow",
        "category": "PowerToys for Bob",
        "title": "Open Task In Window"
      },
      {
        "command": "bob-powertoys.openTaskInEditor",
        "category": "IBM Bob PowerToys",
        "title": "Open Task In Editor"
      }
    ],
    "menus": {
      "bob-code.moreOptions": [
        {
          "command": "bob-powertoys.newTaskInWindow",
          "group": "options@1.5"
        }
      ],
      "webview/context": [
        {
          "command": "bob-powertoys.openTaskInWindow",
          "when": "webviewId == bobChatView && bob-powertoys.hasLastSidebarTask",
          "group": "navigation"
        },
        {
          "command": "bob-powertoys.openTaskInEditor",
          "when": "webviewId == bobChatView && bob-powertoys.hasLastSidebarTask",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PowerToys for Bob",
      "properties": {
        "bob-powertoys.tools.debug.enabled": {
          "order": 1,
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the **debug and breakpoints** tools. Changes take effect on the next Bob turn."
        },
        "bob-powertoys.tools.debug.breakpointNotifications": {
          "order": 2,
          "title": "Breakpoint Notifications",
          "type": "string",
          "enum": [
            "disabled",
            "bobOnly",
            "all"
          ],
          "enumDescriptions": [
            "Never notify Bob when breakpoints are hit",
            "Only notify Bob for breakpoints set through Bob's tools (default)",
            "Notify Bob for all breakpoint hits, regardless of how they were set"
          ],
          "default": "bobOnly",
          "description": "Controls when Bob is automatically notified about breakpoint hits"
        },
        "bob-powertoys.tools.terminal.enabled": {
          "order": 3,
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the **terminal** tools. Changes take effect on the next Bob turn."
        },
        "bob-powertoys.tools.workspace.enabled": {
          "order": 4,
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the **multi-root workspace** tools (only active in workspaces with 2+ root folders). Changes take effect on the next Bob turn."
        },
        "bob-powertoys.tools.video.enabled": {
          "order": 5,
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the **video analysis** tools. Requires ffmpeg on PATH. Changes take effect on the next Bob turn."
        },
        "bob-powertoys.tools.extensions.enabled": {
          "order": 6,
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the **extensions** tool. Changes take effect on the next Bob turn."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "watch": "node esbuild.js --watch",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/vscode": "^1.110.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}